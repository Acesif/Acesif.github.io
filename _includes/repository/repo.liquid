{% assign repo_url = include.repository.repo | split: '/' %}

<div class="repo p-2 w-100">
  <a href="https://github.com/{{ include.repository.repo }}" class="card h-100 hoverable">
    <div class="card-body">
      <h3 class="card-title h5">
        <i class="fa-brands fa-github"></i>
        {{ repo_url[0] }}/<b>{{ repo_url[1] }}</b>
      </h3>
      <p class="card-text">{{ include.repository.description }}</p>
      {% if include.repository.language %}
        <p class="card-text mb-0">
          <small><i class="fa-solid fa-code"></i> {{ include.repository.language }}</small>
        </p>
      {% endif %}
    </div>
  </a>
</div>
